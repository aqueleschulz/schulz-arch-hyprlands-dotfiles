{
  "include": [
    "$HOME/.config/waybar/Modules",
    "$HOME/.config/waybar/ModulesWorkspaces",
    "$HOME/.config/waybar/ModulesCustom",
    "$HOME/.config/waybar/ModulesGroups",
    "$HOME/.config/waybar/UserModules"
  ],
  "layer": "bottom",
  "exclusive": true,
  "passthrough": false,
  "position": "top",
  "spacing": 3,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 3,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "tray",
    "custom/separator#blank",
    "hyprland/workspaces#alpha",
    "custom/separator#blank",
    "clock"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "custom/gpu",
    "custom/separator#blank",
    "cpu",
    "custom/separator#blank",
    "memory",
    "custom/separator#blank",
    "battery",
    "custom/separator#blank",
    "pulseaudio",
    "custom/separator#blank",
    "custom/swaync",
    "custom/separator#blank",
    "custom/power"
  ],
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "{}% 󰢮",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "Uso da Placa de Vídeo"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
  }
}
