###################
### HYPRLAND.CONF #
###################

source = ~/.config/hypr/configs/colors.conf

### MONITORS ###
# Monitor principal
monitor = DP-2, preferred, auto, 1
# Monitor secundário (espelhando a tela principal)
monitor = HDMI-A-1, preferred, auto, 1, mirror, DP-2

### MY PROGRAMS ###
$terminal = kitty
$fileManager = dolphin
$menu = rofi -show drun

### ENVIRONMENT VARIABLES ###
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = MOZ_ENABLE_WAYLAND,1

# --- NVIDIA SPECIFIC VARIABLES ---
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = XDG_SESSION_TYPE,wayland
env = GBM_BACKEND,nvidia-drm
env = GTK_USE_PORTAL,1
env = NVD_BACKEND,direct

### IMPORTAÇÕES (MODULARIZAÇÃO) ###
source = ~/.config/hypr/configs/autostart.conf
source = ~/.config/hypr/configs/looknfeel.conf
source = ~/.config/hypr/configs/UserAnimations.conf
source = ~/.config/hypr/configs/windowrules.conf
source = ~/.config/hypr/configs/layerules.conf
source = ~/.config/hypr/configs/input.conf
source = ~/.config/hypr/configs/keybinds.conf

# Configuração do Layout Dwindle
dwindle {
    pseudotile = true
    preserve_split = true
}

# Configuração do Layout Master
master {
    new_status = master
}

# Variáveis Miscelâneas
misc {
    force_default_wallpaper = 0
    disable_hyprland_logo = true
    vfr = true
}
